{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://memory-tale.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://memory-tale.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
