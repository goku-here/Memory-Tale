# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Supabase (original-quality photo storage): Project settings > API Keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Google Drive for original photos (Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# local development only: replaces Drive with a stand-in so the flows can be tested without Google
# VITE_DRIVE_MOCK=1
