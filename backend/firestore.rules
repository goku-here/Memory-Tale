rules_version = '2';

// DRAFT for cloud sync + sharing (not deployed yet).
// Model:  memories/{memoryId}                     { ownerId, memberIds: [uid], title, ... }
//         memories/{memoryId}/items/{itemId}      canvas items
//         invites/{inviteId}                      { memoryId, createdBy, uses, maxUses }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(memory) { return signedIn() && request.auth.uid in memory.memberIds; }
    function isOwner(memory) { return signedIn() && request.auth.uid == memory.ownerId; }

    match /memories/{memoryId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data);

      match /items/{itemId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data);
      }
    }

    match /invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
