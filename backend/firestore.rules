rules_version = '2';

// memories/{id}                  { ownerId, memberIds: [uid], viewerIds: [uid] (view-only members), members: [..], title, cover, ... }
// memories/{id}/items/{itemId}   { json, updatedAt }
// memories/{id}/assets/{hash}    { data }
// memories/{id}/originals/{photoId} { uploaderUid, name, mime, size, copies: { uid: { fileId } } }
// memories/{id}/presence/{uid}  { name, photo, at }  who has the book open right now (own doc only)
// removals/{uid}_{memoryId}     { uid, memoryId, title, ownerName, fileIds: [driveFileId] }  notice for a removed person
// invites/{token}                { memoryId, createdBy, title, cover, ownerName, ... }  public preview, unguessable token
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(memory) { return signedIn() && request.auth.uid in memory.memberIds; }
    function isViewer(memory) { return signedIn() && request.auth.uid in memory.get('viewerIds', []); }
    function isOwner(memory) { return signedIn() && request.auth.uid == memory.ownerId; }

    match /memories/{memoryId} {
      allow read: if isMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // members with edit access change the book freely and never change the owner. Only the owner can remove other
      // people, ban them or change who may edit; everyone else may only leave (remove themselves).
      allow update: if isMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
        && (isOwner(resource.data)
            || (request.resource.data.get('banned', []) == resource.data.get('banned', [])
                && request.resource.data.get('viewerIds', []) == resource.data.get('viewerIds', [])
                && ((!isViewer(resource.data) && request.resource.data.memberIds.hasAll(resource.data.memberIds))
                    || (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                        && !(request.auth.uid in request.resource.data.memberIds)))));

      // joining: a signed-in person adds only themselves, proving it with a real invite token
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && !(request.auth.uid in resource.data.get('banned', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'viewerIds', 'joinToken', 'updatedAt'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.memoryId == memoryId
        // the link decides whether the newcomer may edit or only look
        && request.resource.data.get('viewerIds', []).hasOnly(resource.data.get('viewerIds', []).concat([request.auth.uid]))
        && ((get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.get('role', 'edit') == 'view')
            == (request.auth.uid in request.resource.data.get('viewerIds', [])));

      allow delete: if isOwner(resource.data);

      match /{sub}/{docId} {
        allow read: if sub in ['items', 'assets', 'originals', 'presence']
          && isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data);
        // view-only members can look but not write; originals hold each person's own Drive copies, so they stay open to all members
        allow write: if (sub in ['items', 'assets']
            && isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data)
            && !isViewer(get(/databases/$(database)/documents/memories/$(memoryId)).data))
          || (sub == 'originals' && isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data))
          || (sub == 'presence' && docId == request.auth.uid
            && isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data));
      }
    }

    // a notice for someone who was removed from a book: only the book's owner writes it, only that person reads/clears it
    match /removals/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && isOwner(get(/databases/$(database)/documents/memories/$(request.resource.data.memoryId)).data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /invites/{token} {
      allow get: if true;       // anyone with the link can see the preview
      allow list: if false;     // but nobody can browse invites
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(get(/databases/$(database)/documents/memories/$(request.resource.data.memoryId)).data);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
