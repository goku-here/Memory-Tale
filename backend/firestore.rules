rules_version = '2';

// Model:  memories/{memoryId}                  { ownerId, memberIds: [uid], title, cover, ... }
//         memories/{memoryId}/items/{itemId}   { json, updatedAt }   canvas items
//         memories/{memoryId}/assets/{hash}    { data }              compressed photos
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(memory) { return signedIn() && request.auth.uid in memory.memberIds; }
    function isOwner(memory) { return signedIn() && request.auth.uid == memory.ownerId; }

    match /memories/{memoryId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data);

      match /{sub}/{docId} {
        allow read, write: if sub in ['items', 'assets']
          && isMember(get(/databases/$(database)/documents/memories/$(memoryId)).data);
      }
    }
  }
}
